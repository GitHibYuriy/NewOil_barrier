PVT_BO_AT_INITIAL = 1.272068024;
PVT_MU_AT_INITIAL_CP = 2.335646391;
PVT_MAX_PRESSURE_KPA = 30000.0;
PVT_ABOVE_PB_MODE = 'LINEAR'; % validated v28; optional 'COMPRESSIBILITY' for Bo
PVT_OIL_COMPRESSIBILITY_1_KPA = 0; % used only with COMPRESSIBILITY mode
